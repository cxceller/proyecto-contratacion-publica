# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# --- API (src/auth.py): obligatoria; sin ella los endpoints protegidos responden 401
API_KEY=

# --- Login de la UI (ui/reportes.py). Fail-closed: sin estas variables nadie entra.
APP_USUARIO=
# Hash argon2id de la clave. Generalo con:
#   .venv/Scripts/python.exe scripts/generar_hash_clave.py
APP_CLAVE_HASH=

# --- Respaldo LLM de los importadores (desactivado por defecto)
LLM_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=

# --- RAG de Contratacion Publica (services/criterio_juridico.py)
RAG_CONTRATACION_URL=http://localhost:8001
RAG_CONTRATACION_TIMEOUT_S=60

# --- Operacion
LOG_LEVEL=INFO
# Solo Cloud Run (scripts/descargar_snapshot_db.py)
# SERCOP_DB_BUCKET=
# Bucket SEPARADO para los respaldos del reset (retencion 30 dias). Si no se define, se usa SERCOP_DB_BUCKET.
# SERCOP_BACKUP_BUCKET=
# SERCOP_DB_OBJECT=contrataciones.db
